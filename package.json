{
  "name": "qaauto_api",
  "version": "1.1.0",
  "type": "module",
  "description": "REST API Test Automation Examples",
  "main": "server.js",
  "scripts": {
    "start:server": "node server.js",
    "test:api": "concurrently --kill-others --success first \"node server.js\" \"npx playwright test tests/\""
  },
  "dependencies": {
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "concurrently": "^10.0.5"
  }
}
